{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=sismo.db"
  },
  "Afad": {
    "BaseUrl": "https://servisnet.afad.gov.tr/apigateway/deprem/apiv2/",
    "UserAgent": "Sismo/1.0"
  },
  "Sync": {
    "Enabled": true,
    "Interval": "00:01:00",
    "Window": "03:00:00",
    "RetentionDays": 30
  },
  "RateLimit": {
    "PermitPerMinute": 60
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  }
}
